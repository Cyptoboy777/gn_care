# Copy these into Vercel: Project > Settings > Environment Variables. Never commit real values.

# --- AI Coach: choose providers, tried in this order (leave empty to use every provider that has credentials) ---
AI_PROVIDERS=cloudflare

# Cloudflare Workers AI (open models, free 10,000 neurons per day)
CF_ACCOUNT_ID=
CF_API_TOKEN=              # API token with Workers AI permission
CF_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# Any OpenAI-compatible API: Groq, OpenRouter, Together, or your own vLLM/Ollama server
AI_BASE_URL=               # e.g. https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=                  # e.g. openai/gpt-oss-20b

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIER=free           # change to "paid" after you enable billing. While "free", visitors from EEA, UK and Switzerland skip Gemini.

# --- Protection for your quota. Set these just under your provider's real limits ---
AI_DAILY_CAP=200           # total online AI answers per day for the whole site
AI_RPM=10                  # total online AI answers per minute for the whole site
AI_IP_HOURLY=6             # per visitor
AI_IP_DAILY=15             # per visitor
RATE_SALT=                 # any random text, used to hash IPs

# --- Optional but recommended: shared counters and answer cache (free at upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Ratings and feedback ---
FEEDBACK_WEBHOOK_URL=      # Apps Script web app URL, see docs/feedback-apps-script.gs
FEEDBACK_SECRET=           # same text as SECRET in the Apps Script

# --- Only if you use extra domains (for example www and non-www) ---
ALLOWED_ORIGINS=

# --- Offline catalog refresh (scripts/refresh-catalog.mjs). Never used at runtime. ---
# Create a free-tier key at https://aistudio.google.com/apikey (no credit card required for the Free tier).
# The script defaults to gemini-2.5-flash-lite with Google Search grounding (free tier: up to 500 grounded requests/day, shared with 2.5 Flash; see docs/catalog-refresh.md).
# Do not set GEMINI_MODEL to gemini-2.5-flash: from 1 Dec 2026 it routes to a Gemini 3 model and is billed.
# Do not use Gemini 3 / 4 models for grounding on the Free tier (grounding is "Not available" there and needs billing).
# Programmable Search / Custom Search JSON API is closed to new customers, so GOOGLE_API_KEY / GOOGLE_CSE_ID are not used.
# GEMINI_API_KEY=          # already listed above; the same free-tier key works for this script
CATALOG_REFRESH_LIMIT=15   # stay well under the 500 RPD grounding cap and your model's RPD in AI Studio
# GEMINI_REFRESH_MODEL=gemini-2.5-flash-lite

# --- Telegram deals poster (scripts/post-telegram-deals.mjs). Manual / optional Actions. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=          # e.g. @gncaredeals or numeric chat id

# --- Offline Flipkart catalog sync (scripts/sync-flipkart.mjs). Never used at runtime. ---
FLIPKART_AFFILIATE_TOKEN=   # Affiliate API token; header Fk-Affiliate-Token. Id is thisisnarenda.
